<section class="ritual" id="ritual">
  <div class="ritual-frame">
        <div class="ritual-photo">
          <img
            src="https://res.cloudinary.com/pdjoc1ti/image/upload/v1793472487/preparar.webp"
            alt="Cuenco celadón, matcha y utensilios sobre lino, listos para preparar el ritual"
            width="900" height="1350" loading="lazy"
          /><span class="photo-caption">MENOS PRISA. MÁS PRESENTE.</span>
        </div>
        <div class="ritual-content">
          <img class="ritual-flower ritual-flower-top" src="https://res.cloudinary.com/pdjoc1ti/image/upload/v1793472494/branch.webp" alt="" aria-hidden="true" width="900" height="1350" loading="lazy" />
          <img class="ritual-flower ritual-flower-bottom" src="https://res.cloudinary.com/pdjoc1ti/image/upload/v1793472494/branch.webp" alt="" aria-hidden="true" width="900" height="1350" loading="lazy" />
          <p class="eyebrow">02 / EL RITUAL</p>
          <h2>La calma<br />se <em>prepara.</em></h2>
          <p class="ritual-lead">
            Tres pequeños gestos.<br />Una forma distinta de empezar.
          </p>
          <div class="steps" role="tablist" aria-label="Pasos del ritual">
            <button
              id="tab-1"
              role="tab"
              aria-selected="true"
              aria-controls="step-panel"
              data-step="0"
            >
              <span class="step-number">01</span> <span>Preparar</span></button
            ><button
              id="tab-2"
              role="tab"
              aria-selected="false"
              aria-controls="step-panel"
              tabindex="-1"
              data-step="1"
            >
              <span class="step-number">02</span> <span>Batir</span></button
            ><button
              id="tab-3"
              role="tab"
              aria-selected="false"
              aria-controls="step-panel"
              tabindex="-1"
              data-step="2"
            >
              <span class="step-number">03</span> <span>Disfrutar</span>
            </button>
          </div>
          <button class="ritual-playback" type="button" aria-controls="step-panel" hidden>Pausar recorrido</button>
          <div
            id="step-panel"
            role="tabpanel"
            aria-labelledby="tab-1"
            tabindex="0"
          >
            <h3>Todo empieza con una pausa.</h3>
            <p>
              Prepara tu cuenco favorito, el matcha y el batidor de bambú. Deja
              espacio para este pequeño momento.
            </p>
          </div>
          <a class="text-link" href="#coleccion"
            >Encuentra tu ritual <span>↗</span></a
          >
        </div>
        </div>
</section>
