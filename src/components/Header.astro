<div class="header-shell">
<header class="site-header">
      <a class="wordmark" href="#" aria-label="Matcha, inicio"
        >MATCHA<span class="mark">◒</span></a
      >
      <nav aria-label="Navegación principal">
        <a href="#matcha">El matcha</a><a href="#ritual">El ritual</a
        ><a href="#preguntas">Preguntas</a>
      </nav>
      <a class="nav-cta" href="#coleccion">Descubrir <span>↗</span></a>
    </header>
</div>

<script>
  const header = document.querySelector('.site-header');
  let scheduled = false;
  const updateHeader = () => {
    header?.classList.toggle('is-floating', window.scrollY > 48);
    scheduled = false;
  };
  window.addEventListener('scroll', () => {
    if (!scheduled) {
      scheduled = true;
      requestAnimationFrame(updateHeader);
    }
  }, { passive: true });
  window.addEventListener('pageshow', updateHeader);
  updateHeader();
</script>
